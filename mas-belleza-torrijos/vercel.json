{
  "version": 2,
  "cleanUrls": true,
  "redirects": [
    { "source": "/admin.htlm", "destination": "/admin", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/reservas/(.*)", "destination": "/api/reservas?codigo=$1" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/aviso-legal", "destination": "/aviso-legal.html" },
    { "source": "/privacidad", "destination": "/privacidad.html" },
    { "source": "/cookies", "destination": "/cookies.html" }
  ]
}
